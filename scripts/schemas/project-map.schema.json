{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "identity_lineage", "repositories", "constraints", "domains"],
  "properties": {
    "schema_version": { "const": 2 },
    "project_id": { "$ref": "#/$defs/id" },
    "knowledge_baseline": { "type": "string", "minLength": 1 },
    "project_identity": { "$ref": "#/$defs/projectIdentity" },
    "identity_lineage": { "type": "array", "items": { "$ref": "#/$defs/identityLineage" } },
    "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" } },
    "revalidation_required": {
      "type": "array",
      "items": { "$ref": "#/$defs/revalidationMarker" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh-CN": { "type": "string", "minLength": 1 }
      }
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "purpose", "calibration_ref"],
      "properties": {
        "label": { "$ref": "#/$defs/localizedText" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "calibration_ref": { "type": "string", "minLength": 1 }
      }
    },
    "identityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_project_id", "relationship", "successor_project_ids", "effective_baseline", "approval_ref"],
      "properties": {
        "predecessor_project_id": { "$ref": "#/$defs/id" },
        "relationship": { "enum": ["SUCCESSOR", "SPLIT", "MERGE"] },
        "successor_project_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "effective_baseline": { "type": "string", "minLength": 1 },
        "approval_ref": { "type": "string", "minLength": 1 },
        "history_locator": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "portable_locator", "integration_ref", "domain_ids", "knowledge_asset_locators", "accepted_revision"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "portable_locator": { "type": "string", "minLength": 1 },
        "integration_ref": { "type": "string", "minLength": 1 },
        "domain_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "knowledge_asset_locators": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/knowledgeAssetLocator" } },
        "accepted_revision": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includes", "excludes"],
      "properties": {
        "includes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excludes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id"],
      "properties": {
        "kind": { "enum": ["coordinates_with", "depends_on", "governed_by"] },
        "target_id": { "$ref": "#/$defs/id" }
      }
    },
    "pairedAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "en", "zh-CN"],
      "properties": {
        "repository_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "en": { "type": "string", "pattern": "^knowledge/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*-en\\.md$" },
        "zh-CN": { "type": "string", "pattern": "^knowledge/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*\\.md$" }
      }
    },
    "knowledgeAssetLocator": {
      "type": "string",
      "pattern": "^knowledge/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*(?:-en)?\\.md$"
    },
    "knowledgeRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": { "type": "string", "pattern": "^knowledge/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*-en\\.md#constraint-[a-z][a-z0-9-]*$" },
        "zh-CN": { "type": "string", "pattern": "^knowledge/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*\\.md#constraint-[a-z][a-z0-9-]*$" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "purpose", "domain_state", "scope", "parent_id", "relationships", "evidence_refs", "known_gaps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["capability", "domain", "project_module"] },
        "label": { "$ref": "#/$defs/localizedText" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "domain_state": { "enum": ["confirmed", "materialized", "merged", "retired"] },
        "scope": { "$ref": "#/$defs/scope" },
        "parent_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "known_gaps": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paired_assets": { "$ref": "#/$defs/pairedAssets" },
        "baseline": { "type": "string", "minLength": 1 },
        "successor_id": { "$ref": "#/$defs/id" },
        "retirement_reason": { "type": "string", "minLength": 1 }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "enum": ["descendants", "selected_descendants", "self"] },
        "owner_id": { "$ref": "#/$defs/id" },
        "selected_descendants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "semantic_revision": { "type": "integer", "minimum": 1 },
        "lifecycle_state": { "enum": ["current", "retired"] },
        "knowledge_refs": { "$ref": "#/$defs/knowledgeRefs" },
        "successor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "retirement_reason_ref": { "type": "string", "minLength": 1 },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraintException" }
        }
      },
      "dependentRequired": {
        "semantic_revision": ["owner_id", "lifecycle_state", "knowledge_refs"],
        "lifecycle_state": ["owner_id", "semantic_revision", "knowledge_refs"],
        "knowledge_refs": ["owner_id", "semantic_revision", "lifecycle_state"]
      },
      "allOf": [{
        "if": { "properties": { "scope": { "const": "selected_descendants" } }, "required": ["scope"] },
        "then": {
          "properties": {
            "owner_id": { "$ref": "#/$defs/id" },
            "selected_descendants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          },
          "required": ["owner_id", "selected_descendants"]
        }
      }]
    },
    "constraintException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "reason_ref", "approval_ref"],
      "properties": {
        "domain_id": { "$ref": "#/$defs/id" },
        "reason_ref": { "type": "string", "minLength": 1 },
        "approval_ref": { "type": "string", "minLength": 1 }
      }
    },
    "revalidationMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "fact_id", "reason_ref"],
      "properties": {
        "domain_id": { "$ref": "#/$defs/id" },
        "fact_id": { "$ref": "#/$defs/id" },
        "reason_ref": { "type": "string", "minLength": 1 },
        "constraint_id": { "$ref": "#/$defs/id" },
        "from_revision": { "type": "integer", "minimum": 1 },
        "to_revision": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "constraint_id": ["from_revision", "to_revision"],
        "from_revision": ["constraint_id", "to_revision"],
        "to_revision": ["constraint_id", "from_revision"]
      }
    }
  }
}
