{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-access-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "task_ref",
    "reason",
    "question",
    "insufficiency_reason",
    "artifact_ids",
    "scope",
    "returned_artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/id" },
    "task_ref": { "$ref": "#/$defs/ref" },
    "reason": { "enum": ["AUDIT", "EXPLICIT_ID", "HISTORICAL_COMPARISON", "INCIDENT", "REGRESSION"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "insufficiency_reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_ids"],
      "properties": {
        "domain_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "approval_ref": { "$ref": "#/$defs/ref" },
    "returned_artifacts": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "content_hash"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
