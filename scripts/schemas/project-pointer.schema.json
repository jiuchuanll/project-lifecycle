{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "repository_id", "governance_locator"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "repository_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "governance_locator": { "type": "string", "minLength": 1 }
  }
}
