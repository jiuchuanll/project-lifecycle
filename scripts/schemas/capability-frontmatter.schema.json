{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "knowledge_state",
    "paired_asset",
    "last_verified_baseline",
    "implementation_refs",
    "verification_refs"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "knowledge_state": { "enum": ["current", "in-progress", "proposed", "superseded"] },
    "paired_asset": { "type": "string", "minLength": 1 },
    "last_verified_baseline": { "type": "string", "minLength": 1 },
    "implementation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "if": {
    "properties": { "knowledge_state": { "const": "current" } },
    "required": ["knowledge_state"]
  },
  "then": {
    "properties": {
      "implementation_refs": { "type": "array", "minItems": 1 },
      "verification_refs": { "type": "array", "minItems": 1 }
    }
  }
}
