{
  "name": "project-lifecycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "project-lifecycle": "./bin/project-lifecycle"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "check:bundle": "npm run build && node --test tests/harnesses/bundle.test.mjs",
    "test": "node --test",
    "test:delivery": "node --test tests/delivery/*.test.mjs",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "validate:fixtures": "node scripts/bin/project-lifecycle.mjs validate-fixtures tests/fixtures",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm test && npm run validate:fixtures && npm run check:privacy"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
